{
    "manifest_version": 3,
    "name": "Fine Print Extension",
    "version": "1.0.0",
    "description": "Extension that analyzes terms and conditions automatically and summarizes them for you.",
    "action": {
        "default_popup": "popup.html"
    },
    "permissions": [
        "storage",
        "scripting"
    ],
    "host_permissions": [
      "https://fineprint-agreement-c7mf.bolt.host/*"
    ],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],
    "web_accessible_resources": [
    {
      "resources": [
        "pdf.min.mjs",
        "pdf.worker.min.mjs"
      ],
      "matches": ["<all_urls>"]
    }
  ],
    "background": {
        "service_worker": "background.js"
    }
}