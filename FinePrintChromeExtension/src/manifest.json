{
    "manifest_version": 3,
    "name": "Fine Print Extension",
    "version": "1.0.0",
    "description": "Extension that analyzes terms and conditions automatically and summarizes them for you.",
    "action": {
        "default_popup": "popup.html"
    },
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],
    "background": {
        "service_worker": "background.js"
    }
}